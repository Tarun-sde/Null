# ==============================================================================
# RentSense Control Tower — Environment Configuration Template
# Copy to .env for local/production deployment.
# NEVER commit actual secrets, credentials, or private keys to source control.
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false

# Database Configuration (SQLite default for dev, PostgreSQL for production)
# Example Postgres: postgresql+psycopg://postgres:password@localhost:5432/rentsense_db
DATABASE_URL=sqlite:///./rentsense.db

# Backend API Configuration
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Telemetry Ingestion & Simulator
SIMULATOR_INTERVAL_SECONDS=5

# Anomaly Detection & Alert Thresholds
ALERT_DUE_SOON_HOURS=48
IDLE_HOURS_THRESHOLD=8.0
LOW_UTILIZATION_THRESHOLD=0.20

# Optional RBAC / Auth Mode
AUTH_ENABLED=false
